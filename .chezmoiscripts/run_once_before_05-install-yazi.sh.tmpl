#!/usr/bin/env bash
# run_once_before_05-install-yazi.sh.tmpl
# 安装 yazi（仅首次 apply 执行）
# 直接取 GitHub Release 的二进制包，避免 apt 源拉入 160+ 个图形依赖

set -euo pipefail

# 日志：终端实时显示 + 写入文件（XDG state 目录）
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/init/$(date +%Y%m%d)"
LOG_FILE="$LOG_DIR/$(date +%H%M%S)-$(basename "$0" .sh).log"
mkdir -p "$LOG_DIR"
exec > >(tee "$LOG_FILE") 2>&1

# macOS：软件统一由 00 脚本用 Homebrew 安装，此处直接跳过
if [[ "$(uname -s)" == "Darwin" ]]; then
    exit 0
fi

if command -v yazi &>/dev/null; then
    echo "✅ yazi 已安装（$(command -v yazi)）"
    exit 0
fi

echo "⏳ 安装 yazi..."
mkdir -p "$HOME/.local/bin"

source "{{ .chezmoi.sourceDir }}/lib/fetch.sh"

case "$(uname -m)" in
    x86_64)          YAZI_TARGET="x86_64-unknown-linux-gnu" ;;
    aarch64 | arm64) YAZI_TARGET="aarch64-unknown-linux-gnu" ;;
    i686 | i386)     YAZI_TARGET="i686-unknown-linux-gnu" ;;
    *)               echo "❌ 不支持的架构: $(uname -m)"; exit 1 ;;
esac

VER="$(gh_latest_tag "sxyazi/yazi")"
if [ -z "$VER" ]; then
    echo "❌ 无法获取 yazi 版本号（api.github.com 与镜像均不可用）"
    exit 1
fi
echo "ℹ️  版本 $VER / $YAZI_TARGET"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

gh_get "sxyazi/yazi/releases/download/v${VER}/yazi-${YAZI_TARGET}.zip" "$TMP/yazi.zip" || exit 1

mkdir -p "$TMP/pkg"

# 优先用 unzip；极简镜像可能没装（如 ubuntu-base），回退到 python3 的 zipfile
if command -v unzip >/dev/null 2>&1; then
    if ! unzip -tq "$TMP/yazi.zip" >/dev/null 2>&1; then
        echo "❌ 下载内容不是有效的 zip（可能是镜像错误页）"
        exit 1
    fi
    unzip -oq "$TMP/yazi.zip" -d "$TMP/pkg"
elif command -v python3 >/dev/null 2>&1; then
    python3 - "$TMP/yazi.zip" "$TMP/pkg" <<'PY' || { echo "❌ zip 校验/解压失败（python3）"; exit 1; }
import sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as z:
    bad = z.testzip()
    if bad:
        print("corrupt member:", bad); sys.exit(1)
    z.extractall(sys.argv[2])
PY
else
    echo "❌ 既没有 unzip 也没有 python3，无法解开压缩包"
    exit 1
fi
install -m 755 "$TMP/pkg/yazi" "$HOME/.local/bin/yazi"
[ -f "$TMP/pkg/ya" ] && install -m 755 "$TMP/pkg/ya" "$HOME/.local/bin/ya"

"$HOME/.local/bin/yazi" --version | head -1
echo "✅ yazi 安装完成 -> $HOME/.local/bin/yazi"
