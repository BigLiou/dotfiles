#!/usr/bin/env bash
# run_once_before_05-install-yazi.sh.tmpl
# 安装 yazi（官方 APT 源，仅首次 apply 执行，Ubuntu）

set -euo pipefail

# 日志：终端实时显示 + 写入文件（XDG state 目录）
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/init/$(date +%Y%m%d)"
LOG_FILE="$LOG_DIR/$(date +%H%M%S)-$(basename "$0" .sh).log"
mkdir -p "$LOG_DIR"
exec > >(tee "$LOG_FILE") 2>&1

# macOS：软件统一由 00 脚本用 Homebrew 安装，此处直接跳过
if [[ "$(uname -s)" == "Darwin" ]]; then
    exit 0
fi

if command -v yazi &>/dev/null; then
    echo "✅ yazi 已安装"
    exit 0
fi

echo "⏳ 添加 yazi 官方 APT 源..."
curl -fsSL https://yazi-rs.github.io/builds/yazi-keyring.gpg | sudo tee /usr/share/keyrings/yazi-keyring.gpg >/dev/null
echo 'deb [signed-by=/usr/share/keyrings/yazi-keyring.gpg] https://yazi-rs.github.io/builds/ stable main' | sudo tee /etc/apt/sources.list.d/yazi.list >/dev/null
sudo apt-get update -y
echo "⏳ 安装 yazi..."
sudo apt-get install -y yazi
echo "✅ yazi 安装完成"
