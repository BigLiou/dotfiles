#!/usr/bin/env bash
# run_once_before_00-install-packages.sh.tmpl
# 安装基础 apt 包（仅首次 apply 执行，Ubuntu 24.04+）

set -euo pipefail

# ====================== 选择 apt 镜像源 ======================
echo "🌐 请选择 apt 镜像源："
echo "  1) 阿里云        (mirrors.aliyun.com)"
echo "  2) 清华大学      (mirrors.tuna.tsinghua.edu.cn)"
echo "  3) 中科大        (mirrors.ustc.edu.cn)"
echo "  4) 不设置        (保持系统默认源)"
read -rp "请输入编号 [1-4，默认 4]：" MIRROR_CHOICE || MIRROR_CHOICE=4
MIRROR_CHOICE=${MIRROR_CHOICE:-4}

case "$MIRROR_CHOICE" in
    1) MIRROR_URL="http://mirrors.aliyun.com/ubuntu/" ;;
    2) MIRROR_URL="https://mirrors.tuna.tsinghua.edu.cn/ubuntu/" ;;
    3) MIRROR_URL="https://mirrors.ustc.edu.cn/ubuntu/" ;;
    *) MIRROR_URL="" ;;
esac

if [ -n "$MIRROR_URL" ]; then
    echo "🌐 切换镜像源：$MIRROR_URL"
    # Ubuntu 24.04+ 统一 deb822 格式；os-release 取代号，无需 lsb-release
    UBUNTU_CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
    sudo tee /etc/apt/sources.list.d/ubuntu.sources > /dev/null <<SOURCES
Types: deb
URIs: $MIRROR_URL
Suites: $UBUNTU_CODENAME $UBUNTU_CODENAME-updates $UBUNTU_CODENAME-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: $MIRROR_URL
Suites: $UBUNTU_CODENAME-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
SOURCES
    echo "✅ 已切换镜像源"
else
    echo "ℹ️ 保持系统默认源，不切换镜像"
fi

echo "📦 安装基础系统包..."

sudo apt-get update -y

PACKAGES=(
    curl wget git zip unzip p7zip-full zsh tmux fzf ripgrep
    eza zoxide btop duf ncdu "batcat bat" "fdfind fd-find"
    build-essential libssl-dev zlib1g-dev libbz2-dev libreadline-dev
    libsqlite3-dev libncursesw5-dev xz-utils tk-dev libxml2-dev
    libxmlsec1-dev libffi-dev liblzma-dev tcpdump net-tools lsof xclip
)

for pkg in "${PACKAGES[@]}"; do
    cmd="${pkg%% *}"
    pkgname="${pkg##* }"
    # cmd 部分可能含空格（如 "rg ripgrep"），取第一个单词作为命令检测
    check_cmd="${cmd%% *}"
    if command -v "$check_cmd" &>/dev/null; then
        echo "✅ $pkgname 已安装，跳过"
    else
        echo "⏳ 安装 $pkgname..."
        sudo apt-get install -y "$pkgname"
    fi
done

echo "✅ 基础系统包安装完成"
