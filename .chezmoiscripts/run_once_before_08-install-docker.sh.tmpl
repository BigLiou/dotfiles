#!/usr/bin/env bash
# run_once_before_08-install-docker.sh.tmpl
# 安装 Docker CE 并配置守护进程（仅首次 apply 执行，Ubuntu 22/24 通用）

set -euo pipefail

# 日志：终端实时显示 + 写入文件（XDG state 目录）
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/init/$(date +%Y%m%d)"
LOG_FILE="$LOG_DIR/$(date +%H%M%S)-$(basename "$0" .sh).log"
mkdir -p "$LOG_DIR"
exec > >(tee "$LOG_FILE") 2>&1

# macOS：Docker 由 00 脚本的 brew（--cask docker-desktop）统一安装，此处直接跳过
if [[ "$(uname -s)" == "Darwin" ]]; then
    exit 0
fi

# ---------- 发行版守卫（apt 源行依赖 Ubuntu 的 VERSION_CODENAME 拼路径） ----------
if ! grep -q '^ID=ubuntu$' /etc/os-release 2>/dev/null; then
    echo "❌ 当前系统不是 Ubuntu，本脚本仅支持 Ubuntu（Docker apt 源路径依赖 VERSION_CODENAME）。"
    echo "   若为 Debian 等系统，请把仓库路径改为 /debian 后手动配置。"
    exit 1
fi

# ---------- 检测 WSL ----------
IS_WSL=0
if grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
    IS_WSL=1
fi

# ---------- systemd 检测（WSL 未启用 systemd 时回退 service 管理） ----------
SYSTEMD_ACTIVE=0
if [ -d /run/systemd/system ]; then
    SYSTEMD_ACTIVE=1
fi

# 统一启停 Docker：优先 systemctl，无 systemd（如旧版 WSL）时回退 service
docker_ctl() {
    local cmd="$1"
    if [ "$SYSTEMD_ACTIVE" -eq 1 ]; then
        sudo systemctl "$cmd" docker
    elif [ "$cmd" = "enable" ]; then
        echo "⚠️ 当前无 systemd，无法设置开机自启（可参考 WSL 下启用 systemd 或在 /etc/wsl.conf 配置后手动启动 dockerd）"
    else
        sudo service docker "$cmd"
    fi
}

# ---------- 是否已安装 Docker / 是否来自 Docker Desktop 集成 ----------
DOCKER_INSTALLED=0
if command -v docker &>/dev/null; then
    DOCKER_INSTALLED=1
fi

# 检测 docker 是否来自 Docker Desktop 的 WSL 集成（引擎在 Windows 侧，WSL 内配置无效）
DOCKER_DESKTOP_INTEGRATED=0
if [ "$DOCKER_INSTALLED" -eq 1 ]; then
    DOCKER_REAL="$(readlink -f "$(command -v docker)" 2>/dev/null || true)"
    case "$DOCKER_REAL" in
        /mnt/c/*|/mnt/wsl/docker-desktop/*)
            DOCKER_DESKTOP_INTEGRATED=1 ;;
    esac
fi

# Docker Desktop 集成：引擎和配置都在 Windows 侧，WSL 内无需任何配置，先于安装提示拦截
if [ "$DOCKER_DESKTOP_INTEGRATED" -eq 1 ]; then
    echo "💡 当前 docker 来自 Docker Desktop 的 WSL 集成（引擎在 Windows 侧），跳过 WSL 内配置："
    echo "   镜像加速、日志限制、BuildKit 请在 Windows 端 Docker Desktop 面板中设置。"
    exit 0
fi

# ---------- 是否安装 Docker ----------
if [ "$IS_WSL" -eq 1 ]; then
    echo "🐳 检测到 WSL 环境：可通过 Docker Desktop 的 WSL 集成使用 Docker，无需在本发行版内另行安装。"
    read -rp "🐳 是否仍需安装 Docker 到当前 WSL 发行版？[y/N，默认否]：" INSTALL_DOCKER || INSTALL_DOCKER=n
else
    read -rp "🐳 是否安装 Docker？[y/N，默认否]：" INSTALL_DOCKER || INSTALL_DOCKER=n
fi
INSTALL_DOCKER=${INSTALL_DOCKER:-n}
case "$INSTALL_DOCKER" in
    y|Y|yes|YES|是) ;;
    *)
        if [ "$IS_WSL" -eq 1 ]; then
            echo "💡 已跳过：可通过 Docker Desktop 启用 WSL 集成来使用 Docker"
        else
            echo "⏭️ 跳过 Docker 安装"
        fi
        exit 0 ;;
esac

if [ "$DOCKER_INSTALLED" -eq 0 ]; then
    echo "🐳 请选择 Docker apt 源："
    echo "  1) 阿里云        (mirrors.aliyun.com，默认)"
    echo "  2) 清华大学      (mirrors.tuna.tsinghua.edu.cn)"
    echo "  3) 中科大        (mirrors.ustc.edu.cn)"
    echo "  4) 官方          (download.docker.com，需代理)"
    read -rp "请输入编号 [1-4，默认 1]：" DOCKER_MIRROR || DOCKER_MIRROR=1
    DOCKER_MIRROR=${DOCKER_MIRROR:-1}

    case "$DOCKER_MIRROR" in
        1) DOCKER_REPO="https://mirrors.aliyun.com/docker-ce/linux/ubuntu" ;;
        2) DOCKER_REPO="https://mirrors.tuna.tsinghua.edu.cn/docker-ce/linux/ubuntu" ;;
        3) DOCKER_REPO="https://mirrors.ustc.edu.cn/docker-ce/linux/ubuntu" ;;
        *) DOCKER_REPO="https://download.docker.com/linux/ubuntu" ;;
    esac

    echo "⏳ 安装 Docker..."
    sudo apt-get install -y -qq ca-certificates curl
    sudo install -m 0755 -d /etc/apt/keyrings
    # 用非 sudo 的 curl 下载 keyring，让 proxy on 时能走代理；再 sudo 安装
    rm -f /tmp/docker.asc
    curl -fsSL --connect-timeout 5 --max-time 30 "$DOCKER_REPO/gpg" -o /tmp/docker.asc
    sudo install -m 0644 /tmp/docker.asc /etc/apt/keyrings/docker.asc
    rm -f /tmp/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] $DOCKER_REPO $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
    sudo apt-get update -y
    sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

# ---------- 配置 daemon.json ----------
if [ -s /etc/docker/daemon.json ]; then
    echo "⚠️ 已存在 /etc/docker/daemon.json，跳过写入（请手动合并日志与 BuildKit 配置）"
else
    echo "⏳ 写入 /etc/docker/daemon.json（日志 10M×3、BuildKit、构建缓存 GC 20GB）..."
    sudo mkdir -p /etc/docker
    sudo tee /etc/docker/daemon.json > /dev/null <<'EOF'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  },
  "features": {
    "buildkit": true
  },
  "builder": {
    "gc": {
      "defaultKeepStorage": "20GB",
      "enabled": true
    }
  }
}
EOF
    echo "✅ daemon.json 已写入"
fi

if [ "$DOCKER_INSTALLED" -eq 0 ]; then
    # 全新安装：加组 + 启动（此时 daemon.json 已在位，直接生效）
    echo "⏳ 配置 docker 用户组并启动服务..."
    sudo usermod -aG docker "${USER:-$(id -un)}"
    docker_ctl enable
    docker_ctl start
    echo "✅ docker 安装完成（加入 docker 组需重新登录生效）"
else
    # 已安装：确保开机自启 + 重启使 daemon.json 生效
    echo "⏳ 设置 docker 开机自启并重启..."
    docker_ctl enable
    docker_ctl restart
    echo "✅ docker 已重启，配置生效"
fi
echo "✅ Docker 配置完成"
