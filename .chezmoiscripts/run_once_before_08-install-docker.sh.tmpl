#!/usr/bin/env bash
# run_once_before_08-install-docker.sh.tmpl
# 安装 Docker CE 并配置守护进程（仅首次 apply 执行，Ubuntu 22/24 通用）

set -euo pipefail

# ---------- 是否安装 Docker ----------
read -rp "🐳 是否安装 Docker？[y/N，默认否]：" INSTALL_DOCKER || INSTALL_DOCKER=n
INSTALL_DOCKER=${INSTALL_DOCKER:-n}
case "$INSTALL_DOCKER" in
    y|Y|yes|YES|是) ;;
    *) echo "⏭️ 跳过 Docker 安装"
       exit 0 ;;
esac

DOCKER_INSTALLED=0
command -v docker &>/dev/null && DOCKER_INSTALLED=1

if [ "$DOCKER_INSTALLED" -eq 0 ]; then
    echo "🐳 请选择 Docker apt 源："
    echo "  1) 阿里云        (mirrors.aliyun.com，默认)"
    echo "  2) 清华大学      (mirrors.tuna.tsinghua.edu.cn)"
    echo "  3) 中科大        (mirrors.ustc.edu.cn)"
    echo "  4) 官方          (download.docker.com，需代理)"
    read -rp "请输入编号 [1-4，默认 1]：" DOCKER_MIRROR || DOCKER_MIRROR=1
    DOCKER_MIRROR=${DOCKER_MIRROR:-1}

    case "$DOCKER_MIRROR" in
        1) DOCKER_REPO="https://mirrors.aliyun.com/docker-ce/linux/ubuntu" ;;
        2) DOCKER_REPO="https://mirrors.tuna.tsinghua.edu.cn/docker-ce/linux/ubuntu" ;;
        3) DOCKER_REPO="https://mirrors.ustc.edu.cn/docker-ce/linux/ubuntu" ;;
        *) DOCKER_REPO="https://download.docker.com/linux/ubuntu" ;;
    esac

    echo "⏳ 安装 Docker..."
    sudo apt-get install -y -qq ca-certificates curl
    sudo install -m 0755 -d /etc/apt/keyrings
    # 用非 sudo 的 curl 下载 keyring，让 proxy on 时能走代理；再 sudo 安装
    curl -fsSL --connect-timeout 5 --max-time 30 "$DOCKER_REPO/gpg" -o /tmp/docker.asc
    sudo install -m 0644 /tmp/docker.asc /etc/apt/keyrings/docker.asc
    rm -f /tmp/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] $DOCKER_REPO $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
    sudo apt-get update -y
    sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

# ---------- 配置 daemon.json ----------
if [ -s /etc/docker/daemon.json ]; then
    echo "⚠️ 已存在 /etc/docker/daemon.json，跳过写入（请手动合并日志与 BuildKit 配置）"
else
    echo "⏳ 写入 /etc/docker/daemon.json（日志 10M×3、BuildKit、构建缓存 GC 20GB）..."
    sudo mkdir -p /etc/docker
    sudo tee /etc/docker/daemon.json > /dev/null <<'EOF'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  },
  "features": {
    "buildkit": true
  },
  "builder": {
    "gc": {
      "defaultKeepStorage": "20GB",
      "enabled": true
    }
  }
}
EOF
    echo "✅ daemon.json 已写入"
fi

if [ "$DOCKER_INSTALLED" -eq 0 ]; then
    # 全新安装：加组 + 启动（此时 daemon.json 已在位，直接生效）
    echo "⏳ 配置 docker 用户组并启动服务..."
    sudo usermod -aG docker "$USER"
    sudo systemctl enable --now docker
    echo "✅ docker 安装完成（加入 docker 组需重新登录生效）"
else
    # 已安装：确保开机自启 + 重启使 daemon.json 生效
    echo "⏳ 设置 docker 开机自启并重启..."
    sudo systemctl enable docker
    sudo systemctl restart docker
    echo "✅ docker 已重启，配置生效"
fi
echo "✅ Docker 配置完成"
