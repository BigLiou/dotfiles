#!/usr/bin/env bash
# run_once_after_01-set-default-shell.sh.tmpl
# 设置 zsh 为默认 shell（配置落盘后执行，仅首次 apply 执行）

set -euo pipefail

# 日志：终端实时显示 + 写入文件（XDG state 目录）
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/init/$(date +%Y%m%d)"
LOG_FILE="$LOG_DIR/$(date +%H%M%S)-$(basename "$0" .sh).log"
mkdir -p "$LOG_DIR"
exec > >(tee "$LOG_FILE") 2>&1

if ! command -v zsh &>/dev/null; then
    echo "⚠️ zsh 未安装，跳过默认 shell 设置"
    exit 0
fi

source "{{ .chezmoi.sourceDir }}/lib/fetch.sh"

ZSH_PATH="$(command -v zsh)"
if [[ "$SHELL" == "$ZSH_PATH" ]]; then
    echo "✅ 默认 shell 已是 zsh"
    exit 0
fi

echo "⏳ 设置 zsh 为默认 shell..."
# 以 root 身份执行，避免 chsh 走 PAM 交互；sudo -n 拿不到免密时快速失败
if sudo -n chsh -s "$ZSH_PATH" "$USER" 2>/dev/null; then
    echo "✅ 默认 shell 已设置为 zsh（退出后重新登录生效）"
    echo "   当前会话执行以下命令立即切换到 zsh："
    echo "   exec zsh"
    export SHELL="$ZSH_PATH"
    # 预置 zinit 插件：zinit light 内部会直接 git clone github.com，
    # 受限网络下会卡 2 分钟并让整个 apply 中断；这里先用 gh_clone 走镜像。
    ZINIT_PLUGINS="$HOME/.local/share/zinit/plugins"
    mkdir -p "$ZINIT_PLUGINS"
    for repo in zsh-users/zsh-autosuggestions zsh-users/zsh-completions zsh-users/zsh-syntax-highlighting; do
        name="$(printf '%s' "$repo" | sed 's|/|---|')"
        [ -d "$ZINIT_PLUGINS/$name" ] && continue
        if ! gh_clone "$repo" "$ZINIT_PLUGINS/$name"; then
            echo "⚠️ 插件 $repo 克隆失败，首次启动 zsh 时会重试"
        fi
    done

    # 加载一次，让 zinit 记录已安装状态（失败不影响其他配置）
    zsh -c 'source "$HOME/.local/share/zinit/zinit.zsh" && \
      zinit light zsh-users/zsh-autosuggestions && \
      zinit light zsh-users/zsh-completions && \
      zinit light zsh-users/zsh-syntax-highlighting' \
      || echo "⚠️ zinit 插件初始化未完成，可稍后手动执行" 
else
    echo "⚠️ 默认 shell 设置失败，请稍后手动运行:"
    echo "   chsh -s $(command -v zsh)"
fi
