#!/usr/bin/env bash
# run_once_before_04-install-claude.sh.tmpl
# 安装 Claude Code CLI（仅首次 apply 执行）

set -euo pipefail

# 日志：终端实时显示 + 写入文件（XDG state 目录）
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/init/$(date +%Y%m%d)"
LOG_FILE="$LOG_DIR/$(date +%H%M%S)-$(basename "$0" .sh).log"
mkdir -p "$LOG_DIR"
exec > >(tee "$LOG_FILE") 2>&1

if command -v claude &>/dev/null || [[ -x "$HOME/.local/bin/claude" ]]; then
    echo "✅ claude 已安装"
    exit 0
fi

echo "⏳ 安装 claude..."
TMP_SH="$(mktemp)"
trap 'rm -f "$TMP_SH"' EXIT

# claude.ai 在部分区域会返回 200 + HTML（"App unavailable in region"），
# 直接 pipe 给 bash 会执行一堆 HTML 垃圾并让整个 apply 中断。
if ! curl -fsSL --retry 3 --connect-timeout 10 --max-time 120 -o "$TMP_SH" https://claude.ai/install.sh; then
    echo "⚠️ 无法下载 claude 安装脚本（网络受限），跳过"
    exit 0
fi

if ! head -n1 "$TMP_SH" | grep -q '^#!'; then
    echo "⚠️ 返回内容不是安装脚本（可能是区域限制页面），跳过 claude 安装"
    echo "   前 120 字节：$(head -c 120 "$TMP_SH" | tr -d '\0')"
    exit 0
fi

bash "$TMP_SH"

echo "✅ claude 安装完成"
