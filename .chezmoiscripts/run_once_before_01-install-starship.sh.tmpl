#!/usr/bin/env bash
# run_once_before_01-install-starship.sh.tmpl
# 安装 starship（仅首次 apply 执行）

set -euo pipefail

# 日志：终端实时显示 + 写入文件（XDG state 目录）
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/init/$(date +%Y%m%d)"
LOG_FILE="$LOG_DIR/$(date +%H%M%S)-$(basename "$0" .sh).log"
mkdir -p "$LOG_DIR"
exec > >(tee "$LOG_FILE") 2>&1

# macOS：软件统一由 00 脚本用 Homebrew 安装，此处直接跳过
if [[ "$(uname -s)" == "Darwin" ]]; then
    exit 0
fi

if command -v starship &>/dev/null; then
    echo "✅ starship 已安装"
    exit 0
fi

echo "⏳ 安装 starship..."
curl -sS https://starship.rs/install.sh | sh -s -- -y
echo "✅ starship 安装完成"
