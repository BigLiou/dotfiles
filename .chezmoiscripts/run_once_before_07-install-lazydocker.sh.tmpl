#!/usr/bin/env bash
# run_once_before_07-install-lazydocker.sh.tmpl
# 安装 lazydocker（官方安装脚本，仅首次 apply 执行，Ubuntu）

set -euo pipefail

# 日志：终端实时显示 + 写入文件（XDG state 目录）
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/init/$(date +%Y%m%d)"
LOG_FILE="$LOG_DIR/$(date +%H%M%S)-$(basename "$0" .sh).log"
mkdir -p "$LOG_DIR"
exec > >(tee "$LOG_FILE") 2>&1

if command -v lazydocker &>/dev/null; then
    echo "✅ lazydocker 已安装"
    exit 0
fi

echo "⏳ 安装 lazydocker..."
curl https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh | bash
echo "✅ lazydocker 安装完成"
