#!/usr/bin/env bash
# run_once_before_06-install-lazygit.sh.tmpl
# 安装 lazygit（GitHub release 二进制，仅首次 apply 执行）
# macOS 由 00 脚本的 Homebrew 分支统一安装；Linux 走 lib/fetch.sh 下载

set -euo pipefail

# 日志：终端实时显示 + 写入文件（XDG state 目录）
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/init/$(date +%Y%m%d)"
LOG_FILE="$LOG_DIR/$(date +%H%M%S)-$(basename "$0" .sh).log"
mkdir -p "$LOG_DIR"
exec > >(tee "$LOG_FILE") 2>&1

# macOS：软件统一由 00 脚本用 Homebrew 安装，此处直接跳过
if [[ "$(uname -s)" == "Darwin" ]]; then
    exit 0
fi

if command -v lazygit &>/dev/null; then
    echo "✅ lazygit 已安装（$(command -v lazygit)）"
    exit 0
fi

source "{{ .chezmoi.sourceDir }}/lib/fetch.sh"

echo "⏳ 安装 lazygit..."
mkdir -p "$HOME/.local/bin"

# lazygit 的 release 资产使用 Go 原始架构名：x86_64 / arm64 / armv7 / 32-bit
case "$(uname -m)" in
    x86_64)          LG_ARCH="x86_64" ;;
    aarch64 | arm64) LG_ARCH="arm64" ;;
    armv7l)          LG_ARCH="armv7" ;;
    i686 | i386)     LG_ARCH="32-bit" ;;
    *)               echo "❌ 不支持的架构: $(uname -m)"; exit 1 ;;
esac

VER="$(gh_latest_tag "jesseduffield/lazygit")"
if [ -z "$VER" ]; then
    echo "❌ 无法获取 lazygit 版本号（api.github.com 不可用）"
    exit 1
fi
echo "ℹ️  版本 $VER / 架构 $LG_ARCH"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

gh_get "jesseduffield/lazygit/releases/download/v${VER}/lazygit_${VER}_linux_${LG_ARCH}.tar.gz" \
       "$TMP/lazygit.tar.gz" || exit 1

if ! tar -tzf "$TMP/lazygit.tar.gz" >/dev/null 2>&1; then
    echo "❌ 下载内容不是有效的 tar.gz（可能是镜像错误页）"
    exit 1
fi

tar -xzf "$TMP/lazygit.tar.gz" -C "$TMP" lazygit
install -m 755 "$TMP/lazygit" "$HOME/.local/bin/lazygit"
"$HOME/.local/bin/lazygit" --version | head -1
echo "✅ lazygit 安装完成 -> $HOME/.local/bin/lazygit"
