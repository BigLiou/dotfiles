# =====================
# 代理
# =====================

# 设置终端代理（默认 192.168.78.66:7897），用法:
#   proxy on                 # 开启
#   proxy on 1.2.3.4:5678    # 指定地址开启
#   proxy off                # 关闭
#   proxy status             # 查看状态
proxy() {
  local action="$1"
  local addr="${2:-192.168.78.66:7897}"

  case "$action" in
    on)
      export HTTP_PROXY="http://$addr"
      export HTTPS_PROXY="http://$addr"
      export ALL_PROXY="socks5://$addr"

      export http_proxy="$HTTP_PROXY"
      export https_proxy="$HTTPS_PROXY"
      export all_proxy="$ALL_PROXY"

      export NO_PROXY="localhost,127.0.0.1,.local"
      export no_proxy="$NO_PROXY"

      echo "终端代理已开启: $addr"
      ;;
    off)
      unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
      unset http_proxy https_proxy all_proxy no_proxy

      echo "终端代理已关闭"
      ;;
    status)
      echo "HTTP_PROXY: ${HTTP_PROXY:-未设置}"
      echo "HTTPS_PROXY: ${HTTPS_PROXY:-未设置}"
      echo "ALL_PROXY: ${ALL_PROXY:-未设置}"
      echo "NO_PROXY: ${NO_PROXY:-未设置}"
      ;;
    *)
      echo "用法: proxy {on|off|status} [host:port]"
      ;;
  esac
}

# docker 设置代理（默认 192.168.78.66:7897），用法:
#   dproxy on                # 开启（写入 systemd 配置并重启 docker）
#   dproxy off               # 关闭
#   dproxy status            # 查看
dproxy() {
  local action="$1"
  local addr="${2:-192.168.78.66:7897}"

  # macOS：无 systemd，Docker 用 Docker Desktop，代理在其面板配置
  if [[ "$(uname -s)" == "Darwin" ]]; then
    echo "ℹ️ macOS 上 Docker 使用 Docker Desktop，请在 Settings → Resources → Proxies 中配置代理"
    return 0
  fi

  case "$action" in
    on)
      sudo mkdir -p /etc/systemd/system/docker.service.d

      sudo tee /etc/systemd/system/docker.service.d/http-proxy.conf >/dev/null <<EOF
[Service]
Environment="HTTP_PROXY=http://$addr"
Environment="HTTPS_PROXY=http://$addr"
EOF

      sudo systemctl daemon-reload
      sudo systemctl restart docker
      echo "Docker代理已开启: $addr"
      ;;
    off)
      sudo rm -f /etc/systemd/system/docker.service.d/http-proxy.conf
      sudo systemctl daemon-reload
      sudo systemctl restart docker
      echo "Docker代理已关闭"
      ;;
    status)
      systemctl show --property=Environment docker
      ;;
    *)
      echo "用法: dproxy {on|off|status} [host:port]"
      ;;
  esac
}

# =====================
# 切换软件镜像源
# =====================

# 交互式切换镜像源，用法：
#   mirror                # 按系统自动选择：mac 切 brew，Ubuntu 切 apt
# macOS：重写 ~/.config/homebrew/mirror.env（tuna/ustc/官方），.zshrc 会自动加载，当前终端立即生效
# Ubuntu：重写 /etc/apt/sources.list.d/ubuntu.sources（先备份 .bak）并 apt-get update
# 切换后自动自检：显示当前生效的镜像配置（brew config / apt 源）
mirror() {
  local m
  local sys=$(uname -s)

  if [[ "$sys" == "Darwin" ]]; then
    echo "🍺 选择 Homebrew 镜像源："
    echo "  1) 清华大学 TUNA   (推荐，国内直连快)"
    echo "  2) 中科大 USTC     (备用)"
    echo "  3) 官方 GitHub     (国外网络或代理环境)"
    read "m?请输入编号 [1-3，默认 1]："
    m=${m:-1}

    # 非法输入默认切清华（避免打错反而落到需代理的官方源）
    if ! [[ "$m" =~ ^[1-3]$ ]]; then
      echo "输入无效，自动选用清华镜像"
      m=1
    fi

    local env_file="$HOME/.config/homebrew/mirror.env"
    mkdir -p "$HOME/.config/homebrew"

    case "$m" in
      1)
        cat > "$env_file" <<'EOF'
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git"
export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/homebrew-core.git"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"
export HOMEBREW_API_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api"
export HOMEBREW_NO_AUTO_UPDATE=1
EOF
        echo "✅ 已切换到清华大学 TUNA"
        ;;
      2)
        cat > "$env_file" <<'EOF'
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
export HOMEBREW_NO_AUTO_UPDATE=1
EOF
        echo "✅ 已切换到中科大 USTC"
        ;;
      3)
        rm -f "$env_file"
        echo "✅ 已切回官方源（需代理）"
        ;;
    esac

    # 当前终端立即生效（新开终端由 .zshrc 自动加载）
    if [ -f "$env_file" ]; then
      source "$env_file"
    else
      unset HOMEBREW_BREW_GIT_REMOTE HOMEBREW_CORE_GIT_REMOTE HOMEBREW_BOTTLE_DOMAIN HOMEBREW_API_DOMAIN 2>/dev/null
    fi

    # 自检：显示当前生效的镜像配置（apt 分支的对应物见下方）
    if command -v brew &>/dev/null; then
      echo ""
      echo "📋 当前镜像配置："
      brew config | grep -E "HOMEBREW_(BREW|CORE)_GIT_REMOTE|HOMEBREW_BOTTLE_DOMAIN|HOMEBREW_API_DOMAIN|HOMEBREW_NO_AUTO_UPDATE" || echo "（未设置镜像变量，使用官方源）"
    else
      echo "ℹ️ brew 未安装，跳过配置显示"
    fi
    return 0
  fi

  # ---------- Ubuntu：切换 apt 镜像源 ----------
  if [[ "$sys" != "Linux" ]] || ! grep -qi ubuntu /etc/os-release 2>/dev/null; then
    echo "❌ 当前系统既不是 macOS 也不是 Ubuntu，不支持换源"
    return 1
  fi

  local MIRROR_URL UBUNTU_CODENAME source_path
  echo "🌐 选择 apt 镜像源："
  echo "  1) 阿里云        (mirrors.aliyun.com)"
  echo "  2) 清华大学      (mirrors.tuna.tsinghua.edu.cn)"
  echo "  3) 中科大        (mirrors.ustc.edu.cn)"
  echo "  4) 官方          (archive.ubuntu.com，恢复默认)"
  read "m?请输入编号 [1-4，默认 4]："
  m=${m:-4}

  # 非法输入恢复官方源
  if ! [[ "$m" =~ ^[1-4]$ ]]; then
    echo "输入错误，恢复官方源"
    m=4
  fi

  case "$m" in
    1) MIRROR_URL="http://mirrors.aliyun.com/ubuntu/" ;;
    2) MIRROR_URL="https://mirrors.tuna.tsinghua.edu.cn/ubuntu/" ;;
    3) MIRROR_URL="https://mirrors.ustc.edu.cn/ubuntu/" ;;
    *) MIRROR_URL="http://archive.ubuntu.com/ubuntu/" ;;
  esac

  UBUNTU_CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
  source_path="/etc/apt/sources.list.d/ubuntu.sources"
  # 自动备份原有源，换源失败可回滚
  sudo cp "$source_path" "${source_path}.bak" 2>/dev/null || true

  sudo tee "$source_path" > /dev/null <<SOURCES
Types: deb
URIs: $MIRROR_URL
Suites: $UBUNTU_CODENAME $UBUNTU_CODENAME-updates $UBUNTU_CODENAME-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: $MIRROR_URL
Suites: $UBUNTU_CODENAME-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
SOURCES

  echo "✅ 已写入 apt 源：$MIRROR_URL"
  echo "正在更新软件缓存……"
  if sudo apt-get update; then
    echo "✅ 更新成功"
    # 自检：显示当前生效的源（apt 版 brew config）
    echo ""
    echo "📋 当前 apt 源："
    grep '^URIs:' "$source_path" | sort -u
  else
    echo "❌ 更新失败，原源已备份：${source_path}.bak"
    return 1
  fi
}

# =====================
# 端口查进程
# =====================

# 查看端口被哪个进程占用，用法:
#   findport 8080           # 查看 8080 端口的进程
#   findport 8080 -k        # 查看并杀掉占用进程
#   findport 8080 -k -9     # 查看并强杀 (-9 可换成任意信号)
findport() {
  if [ $# -lt 1 ]; then
    echo "用法: findport <port> [-k] [信号]"
    echo "  -k    杀掉占用该端口的进程"
    echo "  信号  传给 kill 的信号值，默认 TERM (15)"
    return 1
  fi

  local port="$1"
  local do_kill=0
  local signal="TERM"

  # 解析可选参数
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -k) do_kill=1 ;;
      -*) signal="${1#-}" ;;
    esac
    shift
  done

  # 用 ss 查监听端口的进程，优先
  local pid_info
  pid_info=$(ss -tlnp "sport = :$port" 2>/dev/null | tail -n +2)

  if [ -z "$pid_info" ]; then
    # ss 没找到，试试 lsof
    if command -v lsof >/dev/null 2>&1; then
      pid_info=$(lsof -i ":$port" 2>/dev/null)
    fi
  fi

  if [ -z "$pid_info" ]; then
    echo "端口 $port 没有被占用"
    return 1
  fi

  # 提取 PID — 只匹配 ss 的 pid=NNNN 或 lsof 第二列的 PID
  local pids
  if echo "$pid_info" | grep -q 'pid='; then
    # ss 格式: users:(("nginx",pid=48088,fd=3))
    pids=$(echo "$pid_info" | grep -oP 'pid=\K\d+' | sort -u)
  else
    # lsof 格式: COMMAND PID USER ...
    pids=$(echo "$pid_info" | awk 'NR>1 {print $2}' | grep -E '^[0-9]+$' | sort -u)
  fi

  if [ -z "$pids" ]; then
    echo "端口 $port 被占用，但未能识别出 PID（可能需要 root 权限）"
    return 1
  fi

  # 取第一个 PID（监听端口只会有一个进程）
  local pid
  pid=$(echo "$pids" | head -1)

  # 展示信息
  local cmd="(未知)"
  if [ -r "/proc/$pid/cmdline" ]; then
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" | head -c 300)
  fi
  echo "端口 $port 被以下进程占用:"
  echo "  PID: $pid"
  echo "  命令: $cmd"

  if [ "$do_kill" -eq 1 ]; then
    echo "→ 正在发送 SIG$signal 到 PID $pid ..."
    kill "-$signal" "$pid" 2>/dev/null && echo "  已杀掉" || echo "  操作失败"
  fi
}

# =====================
# 万能打包 / 万能解压（支持指定目录 + 依赖检测）
# =====================

# 前置依赖校验函数
_check_deps() {
  local missing=()
  if ! command -v 7z >/dev/null 2>&1; then
    # Ubuntu 包名 p7zip-full，macOS(brew) 包名 p7zip
    if [[ "$(uname -s)" == "Darwin" ]]; then
      missing+=("p7zip")
    else
      missing+=("p7zip-full")
    fi
  fi
  command -v unzip >/dev/null 2>&1 || missing+=("unzip")

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "⚠️ 缺少依赖包：${missing[*]}"
    if [[ "$(uname -s)" == "Darwin" ]]; then
      echo "请执行安装命令：brew install p7zip zip unzip"
    else
      echo "请执行安装命令：sudo apt update && sudo apt install p7zip-full zip unzip"
    fi
    return 1
  fi
  return 0
}

# pack：按扩展名自动选择压缩方式，用法:
#   pack app.tar.xz ./myapp        # 自动处理 tar.gz / tar.xz / tar.bz2 / zip / 7z
pack() {
  # 打包前校验依赖
  _check_deps || return 1

  [[ $# -lt 2 ]] && {
    echo "用法：pack 输出压缩包名 待打包文件/目录..."
    echo "示例：pack app.tar.xz ./myapp"
    return 1
  }
  local out="$1"
  shift
  case "$out" in
    *.tar.gz|*.tgz)   tar -czpf "$out" "$@" ;;
    *.tar.xz|*.txz)   tar -cJpf "$out" "$@" ;;
    *.tar.bz2|*.tbz2) tar -cjpf "$out" "$@" ;;
    *.zip)            7z a -tzip -mx=9 -bb1 "$out" "$@" ;;
    *.7z)             7z a -t7z -mx=9 -bb1 "$out" "$@" ;;
    *)
      echo "不支持格式：$out"
      return 2
      ;;
  esac
  echo "✅ 打包完成：$out"
}

# extract：按扩展名自动识别并解压，用法:
#   extract 压缩包                 # 解压到当前目录
#   extract 压缩包 目标目录        # 解压到指定目录（自动创建）
extract() {
  # 解压前校验依赖
  _check_deps || return 1

  [[ $# -eq 0 ]] && {
    echo "用法:"
    echo "  extract 压缩包                # 解压到当前目录"
    echo "  extract 压缩包 目标目录       # 解压到指定目录"
    echo "示例：extract node.tar.xz ~/tmp"
    return 1
  }

  local file="$1"
  local dest="$2"

  [[ ! -f "$file" ]] && { echo "错误：文件 $file 不存在"; return 1; }

  # 目标目录不存在自动创建
  if [[ -n "$dest" ]]; then
    mkdir -p "$dest"
  fi

  case "$file" in
    *.tar.gz|*.tgz)
      [[ -n "$dest" ]] && tar xzf "$file" -C "$dest" || tar xzf "$file"
      ;;
    *.tar.xz|*.txz)
      [[ -n "$dest" ]] && tar xJf "$file" -C "$dest" || tar xJf "$file"
      ;;
    *.tar.bz2|*.tbz2)
      [[ -n "$dest" ]] && tar xjf "$file" -C "$dest" || tar xjf "$file"
      ;;
    *.tar)
      [[ -n "$dest" ]] && tar xf "$file" -C "$dest" || tar xf "$file"
      ;;
    *.zip)
      [[ -n "$dest" ]] && unzip -O CP936 "$file" -d "$dest" || unzip -O CP936 "$file"
      ;;
    *.7z|*.rar|*.zipx|*.iso)
      [[ -n "$dest" ]] && 7z x "$file" -o"$dest" || 7z x "$file"
      ;;
    *.gz)
      echo "提示：单文件gz仅能解压至同目录，无法指定路径"
      gunzip "$file"
      ;;
    *.bz2)
      echo "提示：单文件bz2仅能解压至同目录，无法指定路径"
      bunzip2 "$file"
      ;;
    *)
      echo "暂不支持解压格式：$file"
      return 2
      ;;
  esac

  if [[ -n "$dest" ]]; then
    echo "✅ 解压完毕：$file → $dest"
  else
    echo "✅ 解压完毕：$file"
  fi
}

# =====================
# 自定义命令速查手册
# =====================

# tips：别名/函数速查手册，用法:
#   tips          # 展示自定义别名（~/.zsh_aliases）
#   tips -a       # 同上，展示别名
#   tips -f       # 展示自定义函数（~/.zsh_functions）
#   tips -h       # 显示用法帮助
tips() {
  # 依赖检测（Ubuntu 二进制名 batcat，macOS(brew) 是 bat）
  local bat="batcat"
  if ! command -v batcat &>/dev/null; then
    bat="bat"
    if ! command -v bat &>/dev/null; then
      echo "⚠️ 缺少依赖：bat"
      if [[ "$(uname -s)" == "Darwin" ]]; then
        echo "请执行安装命令：brew install bat"
      else
        echo "请执行安装命令：sudo apt install bat"
      fi
      return 1
    fi
  fi

  case "$1" in
    -h|--help)
      echo "tips — 自定义命令速查手册"
      echo ""
      echo "用法："
      echo "  tips          展示自定义别名（~/.zsh_aliases）"
      echo "  tips -a       展示自定义别名（同默认）"
      echo "  tips -f       展示自定义函数（~/.zsh_functions）"
      echo "  tips -h       显示本帮助"
      ;;
    -f)
      echo "🛠️  自定义函数（~/.zsh_functions）"
      if [[ -f "$HOME/.zsh_functions" ]]; then
        "$bat" --language=sh "$HOME/.zsh_functions"
      else
        echo "（~/.zsh_functions 不存在）"
      fi
      ;;
    *)
      echo "📋 自定义别名（~/.zsh_aliases）"
      if [[ -f "$HOME/.zsh_aliases" ]]; then
        "$bat" --language=sh "$HOME/.zsh_aliases"
      else
        echo "（~/.zsh_aliases 不存在）"
      fi
      ;;
  esac
}
