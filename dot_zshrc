# =====================
# 基础环境
# =====================

export EDITOR=vim
# macOS(Apple Silicon) 的 Homebrew bin 默认不在 PATH，需前置（与 brew shellenv 一致）
[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"
# Homebrew 国内镜像环境变量（由 00 脚本在 mac 上写入，仅选镜像源时存在）
[ -f "$HOME/.config/homebrew/mirror.env" ] && source "$HOME/.config/homebrew/mirror.env"
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# =====================
# 自定义配置路径
# =====================

# Starship 配置
export STARSHIP_CONFIG="$HOME/.config/starship.toml"

# mise 配置
export MISE_GLOBAL_CONFIG_FILE="$HOME/mise.toml"

HISTSIZE=10000
SAVEHIST=10000

setopt APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY

# =====================
# 自动补全
# =====================

autoload -Uz compinit
compinit

# =====================
# Zinit 插件管理器
# =====================

ZINIT_HOME="$HOME/.local/share/zinit"

if [ ! -f "$ZINIT_HOME/zinit.zsh" ]; then
    git clone https://github.com/zdharma-continuum/zinit "$ZINIT_HOME"
fi

source "$ZINIT_HOME/zinit.zsh"

# =====================
# 插件
# =====================

zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-syntax-highlighting

# =====================
# 工具
# =====================

# fzf
if command -v fzf >/dev/null 2>&1; then
    # Ubuntu：/usr/share/doc/fzf/examples；macOS(brew)：$(brew --prefix fzf)/shell
    [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && \
        source /usr/share/doc/fzf/examples/key-bindings.zsh

    [ -f /usr/share/doc/fzf/examples/completion.zsh ] && \
        source /usr/share/doc/fzf/examples/completion.zsh

    FZF_SHELL="$(brew --prefix fzf 2>/dev/null)/shell"
    [ -f "$FZF_SHELL/key-bindings.zsh" ] && \
        source "$FZF_SHELL/key-bindings.zsh"

    [ -f "$FZF_SHELL/completion.zsh" ] && \
        source "$FZF_SHELL/completion.zsh"
fi

# zoxide
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# starship
eval "$(starship init zsh)"

# mise
eval "$(mise activate zsh)"

# =====================
# 自定义函数（proxy/dproxy/findport/pack/extract，见 .zsh_functions）
# =====================
[ -f "$HOME/.zsh_functions" ] && source "$HOME/.zsh_functions"

# =====================
# 自定义别名
# =====================
[ -f "$HOME/.zsh_aliases" ] && source "$HOME/.zsh_aliases"
